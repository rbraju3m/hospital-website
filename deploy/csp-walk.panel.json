  {
    "label": "admin login + submit",
    "url": "{BASE}/admin/login",
    "settle": 2000,
    "action": "const f=document.querySelector('form');f.querySelector('[name=email]').value='{EMAIL}';f.querySelector('[name=password]').value='{PASSWORD}';f.requestSubmit();",
    "after": 2500
  },
