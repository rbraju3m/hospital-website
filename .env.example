APP_NAME="RBR Hospital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Whether this site is https is decided here and nowhere else: it sets the
# scheme of every generated link (including the signed confirmation links the
# reminder cron builds, which have no request to take a scheme from) and it is
# what marks the session cookie Secure. In production this is https://.
APP_URL=http://localhost:8000

# Only if something terminates TLS in front of this application — nginx, a load
# balancer, Cloudflare. Comma-separated addresses or CIDR ranges, or '*' to
# trust whatever is directly in front. Left empty for the Apache deployment in
# deploy/, which terminates TLS itself. See config/trustedproxy.php.
TRUSTED_PROXIES=

# The hospital's wall clock. Chamber hours, the booking window and the
# day-before reminder are all local to it.
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to whatever APP_URL's scheme implies, so there is one switch rather
# than two that can disagree. Set it only for a deployment odder than this one.
# SESSION_SECURE_COOKIE=true

# Content-Security-Policy. It ships report-only: a directive too tight breaks
# that page for every visitor and no test here would catch it. Walk the site
# with the browser console open, then set CSP_ENFORCE=true.
#
# That walk was done on 2026-08-28 -- 60 page visits across the public site,
# the panel and the portal, every one of them clean -- so a deployment of this
# code should switch it on. It is per-environment, and this file is the only
# reminder a new one gets.
# CSP_ENABLED=true
CSP_ENFORCE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@rbrhospital.com.bd"
MAIL_FROM_NAME="${APP_NAME}"

# SMS — phone is the only contact detail the booking form requires, so this is
# the channel that reaches every patient.
#
# `log` writes messages to storage/logs/laravel.log; `discard` drops them;
# `http` calls a gateway. Most Bangladeshi providers are one GET or POST, so
# SMS_PARAMS describes what this one calls its parameters. Tokens available:
# :key :to :text :sender
SMS_DRIVER=log
SMS_SENDER=
SMS_URL=
SMS_METHOD=GET
SMS_PARAMS="api_key=:key,to=:to,msg=:text"
SMS_KEY=
# Substring that must appear in the response body for a send to count — local
# gateways routinely answer 200 OK with an error in the body.
SMS_SUCCESS=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
